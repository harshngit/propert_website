
# ---- SEO / analytics (Step 5)
# Public site URL used for canonical tags and schema.org markup
VITE_SITE_URL=https://propertyserch.com
# GA4 measurement id (G-XXXXXXX) and Meta Pixel id - tags load only when set
# and only after the visitor accepts analytics cookies
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
# Register the service worker on a dev server too (off by default)
VITE_ENABLE_SW=
